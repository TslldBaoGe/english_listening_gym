# English Listening Gym — Environment Variables
# Copy to .env and fill in your actual values

# Required: 智谱AI (ZhipuAI) API Key
# Get yours from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_api_key_here

# Optional: LLM model to use (default: glm-4-flash)
# Supported: glm-4-flash, glm-4-plus, glm-4, etc.
LLM_MODEL=glm-4-flash